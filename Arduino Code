#include <LiquidCrystal.h>

// LCD Pins (RS, EN, D4, D5, D6, D7)
LiquidCrystal lcd(7, 6, 5, 4, 3, 2);

const int piezoPin = A0;
const int ledPin = 8;

float voltage = 0.0;
float batteryThreshold = 4.0;  // Battery charged threshold

void setup() {
  Serial.begin(9600);
  lcd.begin(16, 2);
  pinMode(ledPin, OUTPUT);
  
  lcd.print("Piezo Energy");
  delay(2000);
  lcd.clear();
}

void loop() {

  int sensorValue = analogRead(piezoPin);

  // Convert ADC value to voltage
  voltage = (sensorValue * 5.0) / 1023.0;

  // Because of voltage divider (10k & 10k)
  voltage = voltage * 2;  

  Serial.print("Voltage: ");
  Serial.print(voltage);
  Serial.println(" V");

  lcd.setCursor(0, 0);
  lcd.print("Voltage:");
  lcd.setCursor(9, 0);
  lcd.print(voltage);
  lcd.print("V ");

  if (voltage >= batteryThreshold) {
    digitalWrite(ledPin, HIGH);
    lcd.setCursor(0, 1);
    lcd.print("Battery Charged ");
  } else {
    digitalWrite(ledPin, LOW);
    lcd.setCursor(0, 1);
    lcd.print("Charging...      ");
  }

  delay(500);
}
